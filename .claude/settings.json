{
  "permissions": {
    "allow": [
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(test *)",
      "Bash(chmod *)",
      "Bash(git *)",
      "Bash(gh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "chmod +x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/*.sh 2>/dev/null || true"}]
      },
      {
        "matcher": "compact",
        "hooks": [{"type": "command", "command": "echo 'Project rules restored after compaction:\\n- SKILL.md is the source of truth for skill logic\\n- .claude/skills/*.md stubs must mirror SKILL.md frontmatter (name, description, allowed-tools)\\n- No tool-specific APIs inside SKILL.md (must be cross-compatible)\\n- hooks/hooks.json and plugins/ are plugin meta files — edit via structured update only'"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-stub-sync.sh"},
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-skill-frontmatter.sh"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-meta-files.sh"}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "if": "Bash(git push*)", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main-push.sh"}]
      }
    ]
  }
}
